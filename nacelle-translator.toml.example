# Konfiguracja nacelle-translator.
# Skopiuj do nacelle-translator.toml w katalogu, z którego uruchamiasz program
# (domyślnie ./nacelle-translator.toml; inną ścieżkę wskazuje --config PLIK) — bez
# pliku działają wartości domyślne (identyczne z poniższymi). Klucze API
# WYŁĄCZNIE przez zmienne środowiskowe (GEMINI_API_KEY / ANTHROPIC_API_KEY)
# — nigdy w tym pliku.

[audio]
# node.name sprzętowego urządzenia wyjściowego (lista: nacelle-translator devices).
# Zakomentowane = auto-wykrycie: najpierw aktualne skonfigurowane domyślne
# wyjście z PipeWire, a gdy to już MY (bo program działa i jest ustawiony
# jako domyślny) — pierwszy węzeł USB/Bluetooth, potem PCI. Ta druga ścieżka
# to zgadywanka: gdy masz kilka urządzeń, USTAW TO JAWNIE, żeby zawsze trafiać
# w konkretny sprzęt niezależnie od tego, co PipeWire uzna w danej chwili za
# "domyślne" (które po ustawieniu translatora jako default to już on sam).
#output_device = "alsa_output.usb-Logitech_G522_LIGHTSPEED_-_Wireless_Mode_0000000000000000-00.analog-stereo"
passthrough_gain = 1.0   # głośność oryginału bez lektora
duck_gain = 0.2          # głośność oryginału pod lektorem (0.2 ≈ -14 dB)
tts_gain = 1.0           # głośność lektora
duck_attack_ms = 30.0    # jak szybko przyciszać
duck_release_ms = 500.0  # jak wolno wracać
duck_hold_ms = 250.0     # ile trzymać przyciszenie po końcu mowy lektora

[vad]
threshold_enter = 0.5    # próg wejścia w mowę (Silero, 0..1)
threshold_exit = 0.35    # próg podtrzymania (histereza pod muzykę w tle)
preroll_ms = 300         # ile audio sprzed startu mowy doklejać (onset spółgłoskowy)
min_speech_ms = 500      # krótsze wypowiedzi odrzucamy (szum/halucynacje)
hangover_ms = 800        # cisza kończąca wypowiedź (700-1000; za mało tnie zdania)
soft_hangover_ms = 250   # skrócony hangover po przekroczeniu soft_max_ms: szybka mowa
                         # robi między frazami pauzy 200-400ms — za krótkie na pełny
                         # hangover, a wystarczające na porządną granicę cięcia
dip_settle_ms = 500      # tnij w dołku p już po 0,7s od jego wystąpienia — bez czekania
                         # na hard_max; klucz do niskiego opóźnienia przy ciągłej mowie
dip_threshold = 0.6      # próg dołka dla tego cięcia — luźniejszy niż threshold_exit,
                         # bo pod muzyką p nie schodzi nisko nawet na granicach fraz
soft_max_ms = 2000       # od tej długości: (1) szukamy dołka do cięcia,
                         # (2) obowiązuje soft_hangover_ms zamiast hangover_ms
hard_max_ms = 8000       # twarde cięcie ciągłej mowy — sufit awaryjny, gdy nie
                         # trafi się żadna pauza ani dołek
overlap_ms = 250         # nakładka przenoszona po wymuszonym cięciu

[stt]
model = "models/ggml-small.bin"  # model WIELOJĘZYCZNY (nie *.en!)
language = "auto"                # albo kod źródłowy na sztywno, np. "en"
threads = 8                      # rdzenie fizyczne; SMT często szkodzi ggml

[translate]
# "gemini" (domyślny, API w chmurze) | "ollama" (lokalny model przez Ollamę
# — zbyt wolny na dużych wagach, patrz README) | "llamacpp" (lokalny
# llama-server z modelem GGUF na GPU — najniższe opóźnienie, patrz README)
# | "claude" (API) | "off" (test toru bez tłumaczenia)
engine = "gemini"
model = "claude-opus-4-8"        # model dla silnika "claude"; taniej: "claude-haiku-4-5"
gemini_model = "gemini-3.5-flash-lite" # najszybszy wariant — kluczowy dla czasu rzeczywistego
ollama_host = "http://localhost:11434"
ollama_model = "gemma"           # tag modelu w Ollamie (u mnie: Gemma 4, Q4_K_M)
llamacpp_host = "http://localhost:8080" # adres llama-server (uruchamiany z --no-jinja)
target_language = "polski"       # nazwa języka używana w prompcie
target_lang_code = "pl"          # kod porównywany z detekcją whispera
skip_target_lang = true          # nie tłumacz tego, co już jest po polsku
context_pairs = 3                # ile par (oryginał → tłumaczenie) w kontekście
                                  # (dla "gemini" też próg resetu łańcucha previous_interaction_id)
max_tokens = 2048                # limit odpowiedzi (Claude: max_tokens, Ollama: num_predict, Gemini: max_output_tokens)
timeout_s = 15                   # timeout dla silników "claude" i "gemini" (szybkie API)
ollama_timeout_s = 60            # timeout dla silnika "ollama" (lokalny model bywa wolniejszy)

[tts]
piper_bin = "~/.local/share/piper/piper/piper"
voice = "~/.local/share/piper/pl_PL-gosia-medium.onnx"
length_scale = 0.68             # <1.0 = szybsza mowa; agresywnie, bo TranslateGemma tłumaczy rozwlekle
catchup_length_scale = 0.55      # tempo doganiania: gdy zadanie ma >2s zaległości (rozwlekłe
                                 # tłumaczenie wydłużyło kolejkę), lektor chwilowo przyspiesza
                                 # dłuższy od angielskiego — lektor MUSI mówić szybciej
                                 # niż oryginał, inaczej kolejka odtwarzania stale rośnie
sentence_silence = 0.05          # cisza po każdym zdaniu [s]
work_dir = "/dev/shm/nacelle-translator-tts"  # tmpfs — zero realnego I/O
